Step 6 — Add conversation selection

This is the important method.

Add:

selectConversation(
  conversation: Conversation
): void {

  /*
   * Until we implement Stop Generating,
   * don't allow switching conversations
   * while one is actively streaming.
   */
  if (this.isStreaming) {
    return;
  }

  if (
    this.conversationId ===
    conversation.conversation_id
  ) {
    return;
  }

  this.conversationId =
    conversation.conversation_id;

  this.loadConversationMessages(
    conversation.conversation_id
  );
}

*******

Step 7 — Load the selected conversation's messages

Add:

loadConversationMessages(
  conversationId: string
): void {

  this.isLoadingMessages = true;

  /*
   * Clear previous conversation immediately.
   */
  this.messages = [];

  this.chatService
    .getConversationMessages(
      conversationId
    )
    .subscribe({

      next: (messages) => {

        this.messages = messages.map(
          message => ({
            messageId:
              message.message_id,

            role:
              message.role,

            content:
              message.content,

            status:
              message.status,

            createdAt:
              message.created_at,

            responseTimeMs:
              message.response_time_ms
          })
        );

        this.isLoadingMessages = false;
      },

      error: (error) => {

        this.isLoadingMessages = false;

        console.error(
          'Unable to load conversation messages',
          error
        );
      }
    });
}

